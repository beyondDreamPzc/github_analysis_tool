# ===== 可选配置项，全部留空也能运行 =====
# 用法：复制成 .env（server.py 会自动读取，无需 python-dotenv）。
#   cp .env.example .env

# 服务端口
PORT=8787

# GitHub Personal Access Token（可选，但强烈建议）
# 未配置：GitHub API 限额 60 次/小时（约可体检 7 个仓库）
#         且该额度按**出口 IP 共享**，家宽/CGNAT/公司出口常被他人用光 → 请求一律 HTTP 403。
#         注意这时的报错长得像"连不上"，其实是限流：TCP/TLS 全通，只是配额 0/60。
# 已配置：限额 5000 次/小时，且额度独享（根治）
#
# 申请步骤：
#   右上角头像 → Settings → Developer settings
#   → Personal access tokens → Tokens (classic) → Generate new token (classic)
#   → 填 Note 与 Expiration → Scopes 一个都不用勾 → Generate token → 立刻复制
#
# 填法（二选一）：
#   · 本文件：在下面这行等号后面补上 token，然后**重启服务**才生效；
#   · 或直接在页面右上角「⚙️ 高级设置」里粘贴（立即生效，无需重启）。
#
# 注意：别加引号、别在行尾写注释（多一个空格就会变成无效凭据）。
# 重启后页面顶部横幅会显示当前配额，是 5000/5000 就说明生效了。
GITHUB_TOKEN=

# ---- AI 点评（可选）----
# 兼容任何 OpenAI 协议的服务：OpenAI / DeepSeek / 通义千问 / Moonshot / 本地 vLLM 等
# 不配置时自动使用内置规则引擎生成点评，功能不受影响
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 采集缓存时长（毫秒），默认 10 分钟，避免重复消耗 API 配额
CACHE_TTL_MS=600000

# ---- 代理（可选，但很多受限网络下必需）----
# 标准环境变量：https_proxy / HTTPS_PROXY / http_proxy / all_proxy（本工具与 curl / git 行为一致）。
# 除了标准变量，本工具还支持下面的 GITHUB_PROXY，用它可以在不改变环境的前提下覆盖掉
# 环境里已有的代理配置（优先级最高）。
#
# 本工具专用，优先级最高（想指定特定代理时用它，可绕过环境里已有的代理）：
# GITHUB_PROXY=http://127.0.0.1:7890
#
# 例外名单：NO_PROXY=api.github.com,localhost,127.0.0.1
#
# 代理地址可带凭据：http://user:pass@proxy.example.com:8080
# 公司自签证书的 https 代理需要放宽"代理这一跳"的校验时才开启（默认关闭）：
# PROXY_INSECURE_TLS=1
#
# 代理熔断：连续失败 N 次即自动停用一段时间，避免"配了个只会挡路的代理"反而更糟
# PROXY_FAIL_THRESHOLD=3
# PROXY_SUPPRESS_TTL_MS=600000
# PROXY_TIMEOUT_MS=12000
#
# 自检：启动服务后打开 /api/diag?format=text，可看到代理是否真的生效
# （它会用**真实业务接口**验证，而不只是探针 —— 白名单代理能骗过探针）。

# ---- 网络受限环境（可选）----
# 部分环境（公司内网 / 云托管容器 / 特定地区）会对 github.com 做域名级拦截，
# 直连 api.github.com 必然失败。此时工具会自动探测可用镜像作为备用数据通道。
#
# 重要：中继绕不过配额。匿名 60 次/小时是按出口 IP 算的，而公共中继的出口 IP
# 是所有人共用的，往往比你自己先被用光 —— 所以中继只解决"被封锁"，
# 不解决"被限流"。要稳定使用请配 GITHUB_TOKEN。
#
# 关闭备用通道，让网络问题直接暴露：
# GITHUB_RELAY=off
#
# 使用自建反向代理网关（推荐在生产环境使用）：
# GITHUB_RELAY=https://your-gateway.example.com/https://api.github.com
#
# 直接覆盖 API 地址（等价于自建代理，但会走完整替换而非仅回退）：
# GITHUB_API_BASE=https://api.github.com

# 中继容错（公共镜像时好时坏，一般不用改）
# RELAY_ROTATIONS=2            单个请求最多换几个中继候选（抽风时自动换下一个）
# RELAY_ATTEMPTS=3             同一个中继的瞬时故障重试次数
# RELAY_PENALTY_TTL_MS=90000   连续失败后降权 90 秒，期间不再选它
# RELAY_PROBE_GRACE_MS=400     已有可用候选后，再等其他候选的宽限期
# RELAY_CONCURRENCY=3          经中继的并发上限（公共镜像对突发流量敏感）

# 单个上游请求超时（毫秒），默认 15000
REQUEST_TIMEOUT_MS=15000
